{
  "name":  "find-setpoints",
  "entryPoint":  "/find-setpoints.js",
  "points":  {
    "query":  {
      "and":  [
        {
          "and":  [
            {
              "field":  {
                "property":  "type",
                "text":  "OBJECT_FILE"
              }
            },
            {
              "field":  {
                "property":  "bacnet_mac",
                "text":  "10.31.208.100:47808"
              }
            }
          ]
        },
        {
          "field":  {
            "text":  "\"PARS:PRG 1\""
          }
        }
      ]
    },
    "groups":  {
