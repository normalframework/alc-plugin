{
  "name":  "find-setpoints",
  "entryPoint":  "/find-setpoints.js",
  "points":  {
    "query":  {
      "and":  [
        {
          "field":  {
            "property":  "type",
            "text":  "OBJECT_FILE"
          }
        },
        {
          "field":  {
            "text":  "\"PARS:PRG 1\""
          }
        }
      ]
    },
    "groups":  {
      "keys":  [
        "device_id"
      ]
    },
    "labelAttribute":  "name"
  },
  "mode":  "MODE_ON_REQUEST",
  "invokeTimeout":  "43260s",
  "runtimeConfig":  {
    "memoryLimit":  256,
    "maxInstances":  30
  }
}
