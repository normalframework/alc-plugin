{
  "name": "find-setpoints",
  "entryPoint": "/find-setpoints.js",
  "points": {
    "query": {
      "and": [
        {
          "and": [
            {
              "or": [
                {
                  "field": {
                    "property": "type",
                    "text": "OBJECT_FILE"
                  }
                },
                {
                  "field": {
                    "property": "type",
                    "text": "OBJECT_PROGRAM"
                  }
                }
              ]
            },
            {
              "field": {
                "property": "device_id",
                "text": "240025"
              }
            }
          ]
        },
        {
          "field": {
            "text": "\"PARS:PRG 1\""
          }
        }
      ]
    },
    "groups": {
      "keys": [
        "device_id"
      ]
    },
    "labelAttribute": "name"
  },
  "mode": "MODE_ON_REQUEST",
  "invokeTimeout": "14460s",
  "runtimeConfig": {
    "memoryLimit": 256,
    "maxInstances": 15
  }
}
